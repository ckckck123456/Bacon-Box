TabHandles.Elements:Button({
    Title = "开启穿墙",
    Icon = "chevrons-right",
    Variant = "Primary",
    Callback = function()
        if noclipActive then
            noclipActive = false
            if noclipThread then task.cancel(noclipThread) end
            local char = game.Players.LocalPlayer.Character
            if char then
                for _, v in pairs(char:GetChildren()) do
                    pcall(function() if v:IsA("BasePart") then v.CanCollide = true end end)
                end
            end
            WindUI:Notify({ Title = "穿墙", Content = "已关闭", Duration = 2 })
        else
            noclipActive = true
            noclipThread = task.spawn(function()
                while noclipActive do
                    local char = game.Players.LocalPlayer.Character
                    if char then
                        for _, v in pairs(char:GetChildren()) do
                            pcall(function() if v:IsA("BasePart") then v.CanCollide = false end end)
                        end
                    end
                    task.wait()
                end
            end)
            WindUI:Notify({ Title = "穿墙", Content = "已开启", Duration = 2 })
        end
    end
})

